{
  "name": "ekou-elephants",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // The Worker reads index.html (its scripts) to serve the generated page of each place (ADR 0003).
    "binding": "ASSETS",
    // /mapa… and /sitemap.xml: the generated page from the data Worker, or the SPA as always.
    "run_worker_first": ["/api", "/api/*", "/mapa", "/mapa/*", "/sitemap.xml"]
  },
  "observability": {
    "enabled": true
  },
  // Datos del corte mensual: Worker solo de archivos estáticos que publica TASK-15 (docs/ci-cd.md).
  "services": [{ "binding": "DATOS", "service": "ekou-elephants-datos" }],
  "preview_urls": true,
  "previews": {
    "observability": {
      "enabled": true
    },
    // Los previews no heredan los bindings; el workflow puede cambiarlo por el Worker de datos del PR.
    "services": [{ "binding": "DATOS", "service": "ekou-elephants-datos" }]
  }
}
