{
  "name": "ekou-elephants",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Published map data (pipeline → R2). `wrangler dev` emulates it locally in .wrangler/state;
  // load it with `npm run datos:local`. bucket_name must match the R2_BUCKET secret of corte-mensual.
  "r2_buckets": [{ "binding": "DATOS", "bucket_name": "ekou-datos" }],
  "observability": { "enabled": true }
}
