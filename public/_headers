# Geometría del mapa (scripts/geometria-mgn.mjs): una versión nueva usa otro nombre, así que nunca cambia.
/geometria/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/json; charset=utf-8

# JS, CSS y fuentes de Astro (ADR-0004): el nombre lleva el hash del contenido, así que nunca cambia.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
