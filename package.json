{
  "name": "ekou-elephants",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run docs:api && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-dev.mjs",
    "cf-typegen": "wrangler types",
    "datos:local": "node scripts/cargar-datos-local.mjs",
    "migrate:dev": "node --env-file=.env.dev node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql --database-url-var DATABASE_URL_UNPOOLED",
    "migrate:prod": "node --env-file=.env.production node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql --database-url-var DATABASE_URL_UNPOOLED",
    "seed:dev": "node --env-file=.env.dev scripts/seed-dev.mjs",
    "lint": "biome lint --error-on-warnings .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "datos:corte": "node scripts/datos.mjs corte",
    "datos:descargar": "node scripts/datos.mjs descargar",
    "datos:preview": "node scripts/datos.mjs preview",
    "docs:api": "node scripts/generar-docs-api.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@scalar/hono-api-reference": "0.12.20",
    "hono": "^4.13.17",
    "hono-openapi": "1.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@hono/cli": "^0.1.11",
    "@scalar/openapi-to-markdown": "1.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "mapshaper": "0.7.101",
    "neon": "^9.2.0",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6"
  }
}
