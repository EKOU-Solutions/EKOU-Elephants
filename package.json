{
  "name": "ekou-elephants",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:storybook-app",
    "build:storybook-app": "storybook build --quiet --output-dir dist/client/storybook",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "design:check": "node scripts/design-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-dev.mjs",
    "cf-typegen": "wrangler types",
    "datos:local": "node scripts/cargar-datos-local.mjs",
    "migrate:dev": "node --env-file=.env.dev node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql --database-url-var DATABASE_URL_UNPOOLED",
    "migrate:prod": "node --env-file=.env.production node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql --database-url-var DATABASE_URL_UNPOOLED",
    "seed:dev": "node --env-file=.env.dev scripts/seed-dev.mjs",
    "lint": "biome lint --error-on-warnings .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "datos:corte": "node scripts/datos.mjs corte",
    "datos:descargar": "node scripts/datos.mjs descargar",
    "datos:preview": "node scripts/datos.mjs preview",
    "paginas": "node scripts/pages.mjs",
    "corte:referencia": "node scripts/cut.mjs referencia",
    "corte:armar": "node scripts/cut.mjs armar",
    "corte:verificar": "node scripts/cut-verify.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.9",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@hono/cli": "^0.1.11",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "astro": "7.4.12",
    "axe-core": "4.14.0",
    "lucide-react": "0.468.0",
    "mapshaper": "0.7.101",
    "neon": "^9.2.0",
    "node-pg-migrate": "^9.0.0",
    "playwright": "1.65.1",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "diff": "5.2.2"
  }
}
